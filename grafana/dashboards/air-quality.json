{
  "uid": "air-quality",
  "title": "Air quality — Antilles",
  "description": "Particulate matter from the official stations of Gwad'Air and Madininair (raw hourly means) and weather from Météo-France, or both from the six simulated stations. PM10 is compared with the EU daily limit of 50 µg/m³; dust from the Sahara drives the peaks. Particles: « Données temps réel non validées : LCSQA / INERIS (Géod'Air), produites par Gwad'Air et Madininair, data.gouv.fr, Licence Ouverte 2.0 ».",
  "tags": ["sensors", "air-quality"],
  "timezone": "America/Guadeloupe",
  "refresh": "30s",
  "schemaVersion": 41,
  "time": { "from": "now-48h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "station",
        "label": "Particle station",
        "description": "Stations that measure particles: the official Gwad'Air and Madininair stations, or the simulated ones.",
        "type": "query",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
        "query": "select town as __text, station_id as __value from stations where active and source <> 'meteofrance' order by territory, town",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 1
      },
      {
        "name": "weather",
        "label": "Weather station",
        "description": "Stations that measure the weather: Météo-France's, or the simulated ones.",
        "type": "query",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
        "query": "select town as __text, station_id as __value from stations where active and source <> 'airquality' order by territory, town",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Stations online",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select count(*) filter (where status = 'online') as online from station_health"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "max": 6,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 4 },
              { "color": "green", "value": 6 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Stations above the EU PM10 limit (24 h mean)",
      "description": "Stations whose validated PM10 mean over the last 24 hours exceeds the EU daily limit of 50 µg/m³: the signature of a Saharan dust episode when several stations go up together.",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select count(*) as stations from (select station_id from telemetry_clean where ts > now() - interval '24 hours' and station_id in ($station) group by station_id having avg(pm10_ugm3) > 50) above"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Highest hourly PM10 (24 h)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select max(pm10_avg_ugm3) as pm10 from telemetry_hourly where bucket > now() - interval '24 hours'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "conμgm3",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 25 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Readings stored (24 h)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select sum(readings) as readings from telemetry_hourly where bucket > now() - interval '24 hours'"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 5,
      "type": "geomap",
      "title": "Latest PM10 by station",
      "gridPos": { "x": 0, "y": 4, "w": 10, "h": 14 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select town, latitude, longitude, pm10_latest_ugm3 from station_health where station_id in ($station)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "conμgm3",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 25 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "view": { "id": "coords", "lat": 15.35, "lon": -61.3, "zoom": 7.6 },
        "controls": { "showZoom": true, "mouseWheelZoom": false, "showAttribution": true },
        "basemap": { "type": "osm-standard", "name": "OpenStreetMap" },
        "layers": [
          {
            "type": "markers",
            "name": "Stations",
            "location": { "mode": "coords", "latitude": "latitude", "longitude": "longitude" },
            "config": {
              "showLegend": true,
              "style": {
                "size": { "fixed": 12 },
                "color": { "field": "pm10_latest_ugm3", "fixed": "green" },
                "symbol": { "mode": "fixed", "fixed": "img/icons/marker/circle.svg" },
                "text": { "mode": "field", "field": "town" },
                "textConfig": { "fontSize": 12, "offsetX": 14, "offsetY": 0, "textAlign": "left", "textBaseline": "middle" }
              }
            }
          }
        ],
        "tooltip": { "mode": "details" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "PM10",
      "description": "Mean per interval of validated readings: values flagged as a stuck sensor or an isolated spike are left out (see Fleet health > Data quality). The red line is the EU daily limit (50 µg/m³).",
      "gridPos": { "x": 10, "y": 4, "w": 14, "h": 14 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select time_bucket('$__interval', t.ts) as time, s.town as metric, avg(t.pm10_ugm3) as value\nfrom telemetry_clean t join stations s using (station_id)\nwhere $__timeFilter(t.ts) and t.station_id in ($station)\ngroup by 1, 2 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "conμgm3",
          "decimals": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 50 }
            ]
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "PM2.5",
      "description": "Validated readings, like PM10.",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 9 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select time_bucket('$__interval', t.ts) as time, s.town as metric, avg(t.pm2_5_ugm3) as value\nfrom telemetry_clean t join stations s using (station_id)\nwhere $__timeFilter(t.ts) and t.station_id in ($station)\ngroup by 1, 2 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "conμgm3", "decimals": 0, "custom": { "lineWidth": 2, "showPoints": "never" }, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Temperature",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 9 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select time_bucket('$__interval', t.ts) as time, s.town as metric, avg(t.temperature_c) as value\nfrom telemetry t join stations s using (station_id)\nwhere $__timeFilter(t.ts) and t.station_id in ($weather)\ngroup by 1, 2 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "celsius", "decimals": 1, "custom": { "lineWidth": 2, "showPoints": "never" }, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Relative humidity",
      "gridPos": { "x": 0, "y": 27, "w": 12, "h": 9 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select time_bucket('$__interval', t.ts) as time, s.town as metric, avg(t.humidity_pct) as value\nfrom telemetry t join stations s using (station_id)\nwhere $__timeFilter(t.ts) and t.station_id in ($weather)\ngroup by 1, 2 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "humidity", "decimals": 0, "custom": { "lineWidth": 2, "showPoints": "never" }, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Pressure",
      "description": "The two daily highs and lows are the atmospheric tide, strongest in the tropics.",
      "gridPos": { "x": 12, "y": 27, "w": 12, "h": 9 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "select time_bucket('$__interval', t.ts) as time, s.town as metric, avg(t.pressure_hpa) as value\nfrom telemetry t join stations s using (station_id)\nwhere $__timeFilter(t.ts) and t.station_id in ($weather)\ngroup by 1, 2 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "pressurehpa", "decimals": 1, "custom": { "lineWidth": 2, "showPoints": "never" }, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ]
}
